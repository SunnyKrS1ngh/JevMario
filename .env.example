# JevMario — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# ── Required ───────────────────────────────────────────────────────────────
# Your OpenRouter API key (get one at https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Optional: Jev model settings ───────────────────────────────────────────
# JEV_MODEL=typesafe/jev-1.13
# JEV_TIMEOUT=10

# ── Optional: AI timing ────────────────────────────────────────────────────
# How many game frames between Jev decisions (game runs at 60 FPS)
# AI_DECISION_INTERVAL_FRAMES=6

# Hard cap on action duration (frames)
# MAX_ACTION_DURATION_FRAMES=30

# ── Optional: mode ─────────────────────────────────────────────────────────
# "jev"  : use the real Jev API  (default)
# "rule" : use a simple rule-based model (no API key needed)
# AI_MODE=jev

# ── Optional: debug & logging ──────────────────────────────────────────────
# Show in-game AI state overlay (1 = yes, 0 = no)
# DEBUG_AI_STATE=1

# Write JSONL decision logs to ./logs/  (1 = yes, 0 = no)
# LOG_AI_DECISIONS=1
